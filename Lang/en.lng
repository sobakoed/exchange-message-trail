hint.noAddress = {0}: the address does not exist. Examine the address.
hint.badSender = {0}: the sender address is not accepted.
hint.full = {0}: the recipient mailbox is full.
hint.tooBig = {0}: the message is too large.
hint.expired = {0}: the delivery time expired. The recipient server did not answer.
hint.route = {0}: no route: the recipient domain or server is not available, or a loop.
hint.noConnect = {0}: no connection to the recipient server. Exchange tries again.
hint.denied = {0}: rejected. No permission, a delivery restriction, a policy or a filter.
hint.resources = {0}: the server has not sufficient resources. Exchange tries again.
hint.content = {0}: a problem with the message content.
hint.tempPolicy = {0}: a temporary rejection by a policy. Exchange tries again.
hint.permanent = {0}: a permanent error. See the column "Server answer".
hint.temporary = {0}: a temporary error. Exchange tries again.
nores.period = Period: the message can be earlier or later. Make the period larger.
nores.tooOld = The period starts more than 30 days ago. The tracking log keeps data for 30 days by default.
nores.sender = Sender: examine the address. The message can come from another address or from a shared mailbox.
nores.recipient = Recipient: examine the address. The message can go to a group or to another address.
nores.subject = Subject: examine the text. Remove the subject and search only by the addresses.
nores.notSent = The message can be not sent: examine the folders Outbox and Sent Items of the sender.
act.checkMailbox = Check the recipient mailbox
act.deleteThis = Delete this message…
tip.checkMailbox = Read-only. Rules, junk e-mail, forwarding and quota of the mailbox of the selected recipient.
tip.deleteThis = Open the tab "Delete" with the data of this message from the tracking log.
progress.checkMailbox = Mailbox check: {0}
log.checkMailbox = Mailbox check {0}: rules, junk e-mail, forwarding, quota...
log.checkMailboxDone = Mailbox check {0} complete. Important findings: {1}.
log.checkOtherMessage = The mailbox check is complete for another message. Select that message to see the findings.
sev.Alert = Important
sev.Warn = Caution
sev.Info = Information
area.Rules = Rules
area.Junk = Junk e-mail
area.Forwarding = Forwarding
area.Quota = Quota
area.Note = Result
find.noCmd = no cmdlet {0} (no permission)
find.notChecked = Not examined: {0}
find.ruleDelete = The rule "{0}" deletes messages.
find.ruleMove = The rule "{0}" moves messages to the folder "{1}".
find.ruleForward = The rule "{0}" forwards messages: {1}.
find.matchAll = The rule has no conditions: it applies to all messages.
find.matchYes = A condition of the rule applies to this message.
find.matchNo = The conditions of the rule do not apply to this message.
find.matchUnknown = The condition examines the message text: EMT cannot examine it.
find.junkOff = The junk e-mail filter is off.
find.junkBlocked = The sender {0} is in the blocked list: the message is in the folder Junk E-mail.
find.junkTrusted = The sender {0} is in the trusted list.
find.fwdKeep = Mailbox forwarding to {0} is on. A copy stays in the mailbox.
find.fwdNoCopy = Mailbox forwarding to {0} is on. NO copy stays in the mailbox.
find.quotaDb = Mailbox size: {0}. The quota is the database default.
find.quotaNone = Mailbox size: {0}. No quota.
find.quotaFull = The mailbox is full ({0}). New messages are rejected.
find.quotaHigh = The mailbox is {0}% full ({1}). Soon new messages will be rejected.
find.quotaOk = The mailbox is {0}% full ({1}).
find.nothing = No rule, block, forwarding or full mailbox can explain a missing message.
find.note = If the message is not in the mailbox, the user can have deleted or moved it.
del.fromTrace = Data from the tracking log: message {0}.
del.manual = Data typed by the user. The tracking log does not confirm it.
log.delPrefilled = The tab "Delete" has the data of the message {0}. Click "Find copies".

# ---- Window: theme and dialog buttons ----
conn.theme = Theme:
theme.Dark = Dark
theme.Light = Light
tip.theme = The colors of the window. The change applies at once.
dlg.ok = OK
dlg.yes = Yes
dlg.no = No
conn.timeoutBad = Type a number from 5 to 240.

# ---- Delivery status: the causes of a DROP event ----
st.Forwarded = Forwarded by the mailbox
st.Suppressed = Not sent by an Exchange setting
st.GroupBlocked = Rejected by the group
line.Forwarded = forwarded: {0}
line.Suppressed = not sent by a setting: {0}
line.GroupBlocked = rejected by a group: {0}
hint.grpExpanded = {0}: the group was expanded. The members get the message.
hint.forwarded = {0}: the mailbox has forwarding. The message went to the forwarding address, not into the mailbox. Use the mailbox check.
hint.autoForward = {0}: Exchange did not send the automatic forward. The remote domain does not permit it.
hint.oof = {0}: Exchange did not send the automatic reply (Out of Office). The domain settings do not permit it.
hint.ndrSuppressed = {0}: Exchange did not send the non-delivery report. The settings do not permit it.
hint.duplicate = {0}: the recipient was in the message two times. Exchange removed the second copy.
hint.grpBlocked = {0}: the group did not accept the message. The group has a restriction on the senders.
hint.suppressed = {0}: Exchange did not send this copy. This is a setting, not an error.

# ---- Search of copies: more items than messages; the time of the period ----
sum.extraItems = CHECK: mailboxes with more items than the tracking log has messages ({1}): {0}.
confirm.extraItems = CHECK: some mailboxes have more items than the tracking log has messages ({0}): {1}. The query cannot use the message ID. It finds all items with this sender and this subject on these days. These can be other messages of the conversation or copies in Recoverable Items. The delete removes all these items.
tip.time = The time in the format of Windows, for example 14:30. The end of the period includes its minute: 23:59 is up to 23:59:59. The search of messages uses the exact time. The search of copies uses whole days.
crit.timeBad = The time is not correct. Type the time in the format of Windows, for example 14:30.

# ---- Message search by a recipient: the other recipients load on selection ----
