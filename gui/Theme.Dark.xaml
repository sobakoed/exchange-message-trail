<!--
    Dark theme: the colors of the window. Styles.xaml uses these keys (DynamicResource).
    A theme change replaces this dictionary. The window changes at once.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <SolidColorBrush x:Key="Bg.Window"        Color="#FF1F1F1F"/>
  <SolidColorBrush x:Key="Bg.Panel"         Color="#FF272727"/>
  <SolidColorBrush x:Key="Bg.Input"         Color="#FF2D2D2D"/>
  <SolidColorBrush x:Key="Bg.Hover"         Color="#FF383838"/>
  <SolidColorBrush x:Key="Bg.Press"         Color="#FF424242"/>
  <SolidColorBrush x:Key="Bg.Header"        Color="#FF2B2B2B"/>
  <SolidColorBrush x:Key="Bg.Log"           Color="#FF1A1A1A"/>
  <SolidColorBrush x:Key="Border"           Color="#FF3D3D3D"/>
  <SolidColorBrush x:Key="Border.Focus"     Color="#FF3FB950"/>
  <SolidColorBrush x:Key="Fg"               Color="#FFE6E6E6"/>
  <SolidColorBrush x:Key="Fg.Dim"           Color="#FFA0A0A0"/>
  <SolidColorBrush x:Key="Fg.Disabled"      Color="#FF6A6A6A"/>

  <SolidColorBrush x:Key="Accent"           Color="#FF2E9E44"/>
  <SolidColorBrush x:Key="Accent.Hover"     Color="#FF36B150"/>
  <SolidColorBrush x:Key="Accent.Press"     Color="#FF24863A"/>
  <SolidColorBrush x:Key="Accent.Border"    Color="#FF3FB950"/>
  <SolidColorBrush x:Key="Accent.Soft"      Color="#FF1E3A26"/>  <!-- the mark of the quick period button -->
  <SolidColorBrush x:Key="Accent.Disabled"  Color="#FF2C3A30"/>
  <SolidColorBrush x:Key="Accent.Fg"        Color="#FFFFFFFF"/>
  <SolidColorBrush x:Key="Accent.FgDisabled" Color="#FF6E8272"/>

  <SolidColorBrush x:Key="Sel.Bg"           Color="#FF264F78"/>
  <SolidColorBrush x:Key="Sel.Fg"           Color="#FFFFFFFF"/>

  <SolidColorBrush x:Key="Text.Red"         Color="#FFFF7B72"/>
  <SolidColorBrush x:Key="Text.Orange"      Color="#FFE3A33B"/>
  <SolidColorBrush x:Key="Text.Green"       Color="#FF56D364"/>
  <SolidColorBrush x:Key="Text.Blue"        Color="#FF79C0FF"/>
  <SolidColorBrush x:Key="Text.Yellow"      Color="#FFE3B341"/>
  <SolidColorBrush x:Key="Text.Grey"        Color="#FF8B8B8B"/>
  <SolidColorBrush x:Key="Dot.On"           Color="#FF3FB950"/>
  <SolidColorBrush x:Key="Dot.Off"          Color="#FF7A7A7A"/>
  <SolidColorBrush x:Key="Scroll.Thumb"     Color="#FF505050"/>
  <SolidColorBrush x:Key="Scroll.ThumbHover" Color="#FF6A6A6A"/>

</ResourceDictionary>
