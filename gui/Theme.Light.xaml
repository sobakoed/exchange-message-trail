<!--
    Light theme: the same keys as Theme.Dark.xaml.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <SolidColorBrush x:Key="Bg.Window"        Color="#FFF3F3F3"/>
  <SolidColorBrush x:Key="Bg.Panel"         Color="#FFFFFFFF"/>
  <SolidColorBrush x:Key="Bg.Input"         Color="#FFFFFFFF"/>
  <SolidColorBrush x:Key="Bg.Hover"         Color="#FFE8E8E8"/>
  <SolidColorBrush x:Key="Bg.Press"         Color="#FFDADADA"/>
  <SolidColorBrush x:Key="Bg.Header"        Color="#FFF7F7F7"/>
  <SolidColorBrush x:Key="Bg.Log"           Color="#FFFFFFFF"/>
  <SolidColorBrush x:Key="Border"           Color="#FFD0D0D0"/>
  <SolidColorBrush x:Key="Border.Focus"     Color="#FF2E9E44"/>
  <SolidColorBrush x:Key="Fg"               Color="#FF1B1B1B"/>
  <SolidColorBrush x:Key="Fg.Dim"           Color="#FF5F5F5F"/>
  <SolidColorBrush x:Key="Fg.Disabled"      Color="#FFA0A0A0"/>

  <SolidColorBrush x:Key="Accent"           Color="#FF2E9E44"/>
  <SolidColorBrush x:Key="Accent.Hover"     Color="#FF24863A"/>
  <SolidColorBrush x:Key="Accent.Press"     Color="#FF1A6B2D"/>
  <SolidColorBrush x:Key="Accent.Border"    Color="#FF1E7A32"/>
  <SolidColorBrush x:Key="Accent.Disabled"  Color="#FFB5C9B9"/>
  <SolidColorBrush x:Key="Accent.Fg"        Color="#FFFFFFFF"/>
  <SolidColorBrush x:Key="Accent.FgDisabled" Color="#FFEEF3EF"/>

  <SolidColorBrush x:Key="Sel.Bg"           Color="#FFCCE4F7"/>
  <SolidColorBrush x:Key="Sel.Fg"           Color="#FF000000"/>

  <SolidColorBrush x:Key="Text.Red"         Color="#FFB22222"/>
  <SolidColorBrush x:Key="Text.Orange"      Color="#FFC2610C"/>
  <SolidColorBrush x:Key="Text.Green"       Color="#FF228B22"/>
  <SolidColorBrush x:Key="Text.Blue"        Color="#FF0969DA"/>
  <SolidColorBrush x:Key="Text.Yellow"      Color="#FF9A6700"/>
  <SolidColorBrush x:Key="Text.Grey"        Color="#FF6E7781"/>
  <SolidColorBrush x:Key="Dot.On"           Color="#FF2EA043"/>
  <SolidColorBrush x:Key="Dot.Off"          Color="#FFA0A0A0"/>
  <SolidColorBrush x:Key="Scroll.Thumb"     Color="#FFC2C2C2"/>
  <SolidColorBrush x:Key="Scroll.ThumbHover" Color="#FFA6A6A6"/>

</ResourceDictionary>
