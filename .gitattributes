* text=auto
# Windows PowerShell 5.1 needs CRLF and UTF-8 with BOM in .ps1 files. Git keeps the BOM bytes.
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.lng text eol=crlf
*.xaml text eol=crlf
*.md  text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.svg text eol=lf
*.png binary
*.ico binary
